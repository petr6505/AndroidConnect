#!/bin/sh
set -e

if [ "$1" = "configure" ]; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor 2>/dev/null || true
    update-desktop-database -q /usr/share/applications 2>/dev/null || true

    # Start (or restart after an upgrade) the service for logged-in users, so
    # nobody has to log out first. Later logins use /etc/xdg/autostart.
    for uid in $(loginctl list-users --no-legend 2>/dev/null | awk '{print $1}'); do
        user=$(id -nu "$uid" 2>/dev/null) || continue
        [ "$uid" -ge 1000 ] || continue
        systemctl --user -M "$user@" daemon-reload >/dev/null 2>&1 || true
        if [ -n "$2" ]; then
            systemctl --user -M "$user@" try-restart androidconnectd.service >/dev/null 2>&1 || true
        else
            systemctl --user -M "$user@" start androidconnectd.service >/dev/null 2>&1 || true
        fi
    done
fi
exit 0
